{
  "agent": {
    "chat": {
      "font": "FiraCode Nerd Font Propo",
      "size": 15,
      "lineHeight": 1.3,
      "maxWidth": "full",
      "boldColor": "red",
      "linkPaths": true,
      "listSpacing": "relaxed"
    }
  },
  "globalHotkey": "opt+space",
  "links": {
    "routes": [
      {
        "action": "external",
        "match": [
          "*://*/*",
          "file:///*"
        ],
        "modifiers": [
          "shift"
        ],
        "sources": [
          "terminal"
        ]
      },
      {
        "action": "external",
        "match": [
          "*://*/*",
          "file:///*"
        ],
        "modifiers": [
          "shift",
          "cmd"
        ],
        "sources": [
          "chat"
        ]
      }
    ]
  }
}
