#!/usr/bin/env python3
"""Compact inventory of skill and command files in a directory (not an agent session)."""

import argparse
import os
from pathlib import Path
import shutil
import sys
import unicodedata

import yaml


SOURCES = (
    ("CLAUDE", ".claude/skills", "skill"),
    ("CLAUDE", ".claude/commands", "command"),
    ("CODEX", ".agents/skills", "skill"),
    ("CODEX", ".codex/skills", "skill"),
)


def clean(value):
    text = " ".join(str(value).split())
    return "".join(c for c in text if not unicodedata.category(c).startswith("C"))


def width(text):
    return sum(0 if unicodedata.combining(c) else
               2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in text)


def clip(text, limit):
    if width(text) <= limit:
        return text
    result = ""
    for char in text:
        if width(result + char) > limit - 1:
            break
        result += char
    return result + "…"


ERRORS = (OSError, UnicodeError, yaml.YAMLError, ValueError, StopIteration)


def frontmatter(path):
    lines = path.read_text(encoding="utf-8-sig").splitlines()
    data, body = {}, lines
    if lines and lines[0].strip() == "---":
        end = next(i for i in range(1, len(lines)) if lines[i].strip() in ("---", "..."))
        data = yaml.safe_load("\n".join(lines[1:end])) or {}
        body = lines[end + 1:]
    if not isinstance(data, dict):
        raise ValueError("frontmatter must be a mapping")
    return data, body


def metadata(path):
    try:
        data, _ = frontmatter(path)
        return clean(data.get("name") or path.parent.name), clean(data.get("description") or "No description")
    except ERRORS:
        return clean(path.parent.name), "Unreadable skill or invalid frontmatter"


def command_metadata(path, folder):
    # Claude Code namespaces nested commands with ":" and falls back to the first body line.
    name = clean("/" + ":".join(path.relative_to(folder).with_suffix("").parts))
    try:
        data, body = frontmatter(path)
        first = next((text.lstrip("#").strip() for text in body if text.strip()), "")
        return name, clean(data.get("description") or first or "No description")
    except ERRORS:
        return name, "Unreadable command or invalid frontmatter"


def discover(root):
    groups = []
    for agent, relative, kind in SOURCES:
        folder = root / relative
        rows = []
        seen = set()
        # Follow linked skill folders, while pruning cycles and duplicate targets.
        for directory, dirs, files in os.walk(folder, followlinks=True):
            real = Path(directory).resolve()
            if real in seen:
                dirs[:] = []
                continue
            seen.add(real)
            dirs[:] = sorted(d for d in dirs if not d.startswith("."))
            if kind == "command":
                for file in sorted(files):
                    if file.endswith(".md") and not file.startswith("."):
                        path = Path(directory) / file
                        rows.append((*command_metadata(path, folder), path))
            elif "SKILL.md" in files:
                path = Path(directory) / "SKILL.md"
                rows.append((*metadata(path), path))
                dirs[:] = []
        if rows:
            groups.append((agent, relative, kind, sorted(rows, key=lambda row: (row[0].casefold(), str(row[2])))))
    return groups


def recipes(root):
    folder = root / "docs/recipes"
    if not folder.is_dir():
        return []
    return sorted(
        (path for path in folder.iterdir()
         if not path.name.startswith(".") and (path.is_file() or path.is_dir())),
        key=lambda path: (path.name.casefold(), path.name),
    )


def main():
    parser = argparse.ArgumentParser(prog="skills", description=__doc__, epilog="Scans .claude/skills, .claude/commands, .agents/skills, .codex/skills, and docs/recipes. Excludes global and plugin skills.")
    parser.add_argument("directory", nargs="?", default=".", help="directory to inspect (default: cwd)")
    parser.add_argument("-l", "--long", action="store_true", help="show full descriptions and file paths")
    args = parser.parse_args()
    root = Path(args.directory).expanduser().resolve()
    if not root.is_dir():
        parser.error(f"not a directory: {root}")
    groups = discover(root)
    recipe_paths = recipes(root)
    color = sys.stdout.isatty() and "NO_COLOR" not in os.environ and os.environ.get("TERM") != "dumb"
    columns = max(12, shutil.get_terminal_size((88, 24)).columns)

    def style(text, code):
        return f"\033[{code}m{text}\033[0m" if color else text

    def line(text, code="0"):
        print(style(text if args.long else clip(text, columns), code))

    try:
        location = "~/" + str(root.relative_to(Path.home()))
    except ValueError:
        location = str(root)
    def count(kind):
        total = sum(len(rows) for _, _, group_kind, rows in groups if group_kind == kind)
        return f"{total} {kind}{'s' if total != 1 else ''}"

    summary = count("skill")
    if any(kind == "command" for _, _, kind, _ in groups):
        summary += " · " + count("command")
    print()
    line(f"  {clean(location)} · {summary}", "1")
    line("  " + "─" * min(columns - 2, 72), "2")
    if not groups:
        line("  No local skills or commands found.", "2")
        for _, relative, _ in SOURCES:
            line(f"  checked {relative}", "2")
    for agent, relative, _, rows in groups:
        print()
        line(f"  {agent}  {len(rows)} · {relative}", "1;36" if agent == "CODEX" else "1;33")
        name_width = min(max(width(name) for name, _, _ in rows), 28, max(4, columns // 3))
        for name, description, path in rows:
            label = clip(name, name_width)
            label += " " * (name_width - width(label))
            if args.long:
                line(f"    {name} — {description}")
                line(f"      {clean(path.relative_to(root))}", "2")
            else:
                line(f"    {label}  {description}")
    if recipe_paths:
        print()
        line(f"  RECIPES  {len(recipe_paths)} · docs/recipes", "1;35")
        for path in recipe_paths:
            line(f"    {clean(path.name)}{'/' if path.is_dir() else ''}")
            if args.long:
                line(f"      {clean(path.relative_to(root))}", "2")
    print()


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        sys.exit(0)
